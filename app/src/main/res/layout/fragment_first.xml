<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blu1"
    android:orientation="vertical"
    tools:context=".HomeFragment">



    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginTop="10dp"
        app:srcCompat="@drawable/ic_overlay" />


    <LinearLayout
        android:layout_weight="1"
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="5dp">

        <com.rando.factchecker2.GradientTextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Hello, User"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/promptBoxLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="15dp"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/search_back"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingVertical="5dp">

        <EditText
            android:id="@+id/promptBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="100"
            android:background="@color/transparent"
            android:hint="@string/prompt_hint"
            android:inputType="textMultiLine"
            android:textColor="@color/white"
            android:textColorHint="@color/whitish" />


        <Space
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/sendback"
            android:src="@drawable/ic_send" />

        <Space
            android:id="@+id/spaceAfterPrompt"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />


    </LinearLayout>





</LinearLayout>