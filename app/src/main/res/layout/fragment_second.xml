<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".HomeFragment">


    <ScrollView
        android:layout_marginTop="20dp"
        android:id="@+id/messagesScroll"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <LinearLayout
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical"
            android:paddingTop="5dp">

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/promptBoxLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/search_back"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingVertical="5dp">

        <EditText
            android:paddingVertical="12dp"
            android:focusableInTouchMode="true"
            android:id="@+id/promptBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_weight="100"
            android:background="@color/transparent"
            android:hint="@string/prompt_hint"
            android:inputType="textMultiLine"
            android:textColor="@color/white"
            android:textColorHint="@color/whitish" />


        <Space
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/sendback"
            android:src="@drawable/ic_send" />

        <Space
            android:id="@+id/spaceAfterPrompt"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />


    </LinearLayout>



</LinearLayout>